# Ordering Service environment template
ORDERING_APP_NAME=ordering-backend
ORDERING_APP_ENV=development
ORDERING_APP_VERSION=0.1.0

ORDERING_HTTP_HOST=0.0.0.0
ORDERING_HTTP_PORT=4000
ORDERING_HTTP_READ_TIMEOUT=15s
ORDERING_HTTP_WRITE_TIMEOUT=15s
ORDERING_HTTP_IDLE_TIMEOUT=60s

ORDERING_POSTGRES_URL=postgres://postgres:postgres@localhost:5432/ordering?sslmode=disable
ORDERING_POSTGRES_MAX_OPEN_CONNS=20
ORDERING_POSTGRES_MAX_IDLE_CONNS=10
ORDERING_POSTGRES_CONN_MAX_LIFETIME=30m

ORDERING_REDIS_ADDR=localhost:6379
ORDERING_REDIS_USERNAME=
ORDERING_REDIS_PASSWORD=
ORDERING_REDIS_DB=0

ORDERING_NATS_URL=nats://localhost:4222
ORDERING_NATS_STREAM=ordering

ORDERING_OTLP_ENDPOINT=



# Auth Service SSO (JWT) settings - Production
ORDERING_AUTH_SERVICE_URL=https://sso.codevertexafrica.com
ORDERING_AUTH_ISSUER=https://sso.codevertexafrica.com
ORDERING_AUTH_AUDIENCE=codevertex
ORDERING_AUTH_JWKS_URL=https://sso.codevertexafrica.com/api/v1/.well-known/jwks.json
ORDERING_AUTH_JWKS_CACHE_TTL=3600s
ORDERING_AUTH_JWKS_REFRESH_INTERVAL=300s
ORDERING_AUTH_ENABLE_API_KEY_AUTH=true