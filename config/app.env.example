# Cafe Backend environment template
CAFE_APP_NAME=cafe-backend
CAFE_APP_ENV=development
CAFE_APP_VERSION=0.1.0

CAFE_HTTP_HOST=0.0.0.0
CAFE_HTTP_PORT=4000
CAFE_HTTP_READ_TIMEOUT=15s
CAFE_HTTP_WRITE_TIMEOUT=15s
CAFE_HTTP_IDLE_TIMEOUT=60s

CAFE_POSTGRES_URL=postgres://postgres:postgres@localhost:5432/cafe?sslmode=disable
CAFE_POSTGRES_MAX_OPEN_CONNS=20
CAFE_POSTGRES_MAX_IDLE_CONNS=10
CAFE_POSTGRES_CONN_MAX_LIFETIME=30m

CAFE_REDIS_ADDR=localhost:6379
CAFE_REDIS_USERNAME=
CAFE_REDIS_PASSWORD=
CAFE_REDIS_DB=0

CAFE_NATS_URL=nats://localhost:4222
CAFE_NATS_STREAM=cafe

CAFE_OTLP_ENDPOINT=

# Legacy auth config (DEPRECATED - kept for backward compatibility only)
# In production, use auth-service for all authentication. These are only used as fallback.
# FOOD_DELIVERY_AUTH_ACCESS_TOKEN_SECRET=dev-access-secret-change-me
# FOOD_DELIVERY_AUTH_REFRESH_TOKEN_SECRET=dev-refresh-secret-change-me
# FOOD_DELIVERY_AUTH_ACCESS_TOKEN_TTL=15m
# FOOD_DELIVERY_AUTH_REFRESH_TOKEN_TTL=720h
# FOOD_DELIVERY_AUTH_GOOGLE_CLIENT_ID=
# FOOD_DELIVERY_AUTH_GOOGLE_CLIENT_SECRET=
# FOOD_DELIVERY_AUTH_GOOGLE_REDIRECT_BASE=http://localhost:3000/auth/callback
# FOOD_DELIVERY_AUTH_TWO_FACTOR_ISSUER=Urban Cafe Delivery

# Auth Service SSO (JWT) settings - Production
CAFE_AUTH_SERVICE_URL=https://sso.codevertexitsolutions.com
CAFE_AUTH_ISSUER=https://auth.bengobox.local
CAFE_AUTH_AUDIENCE=codevertex
CAFE_AUTH_JWKS_URL=https://sso.codevertexitsolutions.com/api/v1/.well-known/jwks.json
CAFE_AUTH_JWKS_CACHE_TTL=3600s
CAFE_AUTH_JWKS_REFRESH_INTERVAL=300s
CAFE_AUTH_ENABLE_API_KEY_AUTH=true