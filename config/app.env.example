# Food Delivery Backend environment template
FOOD_DELIVERY_APP_NAME=food-delivery-backend
FOOD_DELIVERY_APP_ENV=development
FOOD_DELIVERY_APP_VERSION=0.1.0

FOOD_DELIVERY_HTTP_HOST=0.0.0.0
FOOD_DELIVERY_HTTP_PORT=4000
FOOD_DELIVERY_HTTP_READ_TIMEOUT=15s
FOOD_DELIVERY_HTTP_WRITE_TIMEOUT=15s
FOOD_DELIVERY_HTTP_IDLE_TIMEOUT=60s

FOOD_DELIVERY_POSTGRES_URL=postgres://postgres:postgres@localhost:5432/food_delivery?sslmode=disable
FOOD_DELIVERY_POSTGRES_MAX_OPEN_CONNS=20
FOOD_DELIVERY_POSTGRES_MAX_IDLE_CONNS=10
FOOD_DELIVERY_POSTGRES_CONN_MAX_LIFETIME=30m

FOOD_DELIVERY_REDIS_ADDR=localhost:6379
FOOD_DELIVERY_REDIS_USERNAME=
FOOD_DELIVERY_REDIS_PASSWORD=
FOOD_DELIVERY_REDIS_DB=0

FOOD_DELIVERY_NATS_URL=nats://localhost:4222
FOOD_DELIVERY_NATS_STREAM=food-delivery

FOOD_DELIVERY_OTLP_ENDPOINT=

FOOD_DELIVERY_AUTH_ACCESS_TOKEN_SECRET=dev-access-secret-change-me
FOOD_DELIVERY_AUTH_REFRESH_TOKEN_SECRET=dev-refresh-secret-change-me
FOOD_DELIVERY_AUTH_ACCESS_TOKEN_TTL=15m
FOOD_DELIVERY_AUTH_REFRESH_TOKEN_TTL=720h
FOOD_DELIVERY_AUTH_GOOGLE_CLIENT_ID=
FOOD_DELIVERY_AUTH_GOOGLE_CLIENT_SECRET=
FOOD_DELIVERY_AUTH_GOOGLE_REDIRECT_BASE=http://localhost:3000/auth/callback
FOOD_DELIVERY_AUTH_TWO_FACTOR_ISSUER=Urban Cafe Delivery

# Auth Service SSO (JWT) settings
CAFE_AUTH_SERVICE_URL=https://auth.codevertex.local:4101
CAFE_AUTH_ISSUER=https://auth.codevertex.local:4101
CAFE_AUTH_AUDIENCE=codevertex
CAFE_AUTH_JWKS_URL=https://auth.codevertex.local:4101/api/v1/.well-known/jwks.json
CAFE_AUTH_JWKS_CACHE_TTL=3600s
CAFE_AUTH_JWKS_REFRESH_INTERVAL=300s